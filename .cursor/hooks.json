{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "command": ".cursor/hooks/session-start-sot.py"
      },
      {
        "command": ".cursor/hooks/ensure-codegraph.sh"
      },
      {
        "command": ".cursor/hooks/codegraph-autosync.py"
      }
    ],
    "afterFileEdit": [
      {
        "command": ".cursor/hooks/codegraph-autosync.py"
      }
    ],
    "preCompact": [
      {
        "command": ".cursor/hooks/precompact-handoff-warn.py"
      }
    ],
    "stop": [
      {
        "command": ".cursor/hooks/stop-handoff-nudge.py",
        "loop_limit": 1
      }
    ]
  }
}
